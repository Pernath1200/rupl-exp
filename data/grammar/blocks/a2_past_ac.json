  "quiz": [
    {
      "prompt": "I lived (m) →",
      "choices": [
        "mieszkałem",
        "mieszkałam",
        "mieszkałeś",
        "mieszkał"
      ],
      "answer": "mieszkałem"
    },
    {
      "prompt": "Mama ___ w domu.",
      "choices": [
        "mieszkała",
        "mieszkał",
        "mieszkało",
        "mieszkam"
      ],
      "answer": "mieszkała",
      "explain": "mama is feminine, so the past verb takes -a — the same choice you made with mama była."
    },
    {
      "prompt": "Tata ___ książkę.",
      "choices": [
        "czytał",
        "czytała",
        "czytałem",
        "czyta"
      ],
      "answer": "czytał",
      "explain": "The he-form has no ending at all — the word stops at the -ł. Adding -em would make it mean I, and -a would make it she."
    },
    {
      "prompt": "Wczoraj ___ w domu. (f)",
      "choices": [
        "pracowałam",
        "pracowałem",
        "pracowała",
        "pracuję"
      ],
      "answer": "pracowałam",
      "explain": "The past comes from the infinitive pracować, never from the present pracuję — so it is pracowa- + ł, then -am for a woman speaking."
    },
    {
      "prompt": "Fix: Ona mieszkał w mieście. →",
      "choices": [
        "mieszkała",
        "mieszkał",
        "mieszkało",
        "mieszkałam"
      ],
      "answer": "mieszkała"
    },
    {
      "prompt": "he was working →",
      "choices": [
        "pracował",
        "pracowała",
        "pracowałem",
        "pracuje"
      ],
      "answer": "pracował"
    },
    {
      "prompt": "Anna ___ w parku.",
      "choices": [
        "grała",
        "grał",
        "grałem",
        "gra"
      ],
      "answer": "grała"
    },
    {
      "prompt": "Dziecko ___ w mieście.",
      "choices": [
        "mieszkało",
        "mieszkał",
        "mieszkała",
        "mieszkałem"
      ],
      "answer": "mieszkało",
      "explain": "dziecko is neuter, and the neuter past ending is -o — exactly as in dziecko było."
    },
    {
      "prompt": "Mama ___ chleb.",
      "choices": [
        "kupowała",
        "kupował",
        "kupowałam",
        "kupuje"
      ],
      "answer": "kupowała",
      "explain": "kupuje is the present. For the past, go back to the infinitive kupować: kupowa- + ł + -a for a feminine subject."
    },
    {
      "prompt": "I knew (f) →",
      "choices": [
        "znałam",
        "znała",
        "znał",
        "znam"
      ],
      "answer": "znałam"
    }
