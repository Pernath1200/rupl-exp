  "quiz": [
    {
      "prompt": "Mama ___ śniadanie.",
      "choices": [
        "robiła",
        "robił",
        "robiło",
        "robiłam"
      ],
      "answer": "robiła",
      "explain": "mama is feminine, so the past verb takes -a. robiłam would mean I was making it — that -m is the speaker."
    },
    {
      "prompt": "Tata ___ piwo.",
      "choices": [
        "pił",
        "piła",
        "piłem",
        "piłam"
      ],
      "answer": "pił",
      "explain": "No ending at all is the he form. Cut -ć off pić and add -ł: pi + ł = pił, the whole word."
    },
    {
      "prompt": "Anna ___ psa.",
      "choices": [
        "miała",
        "miał",
        "miało",
        "miałem"
      ],
      "answer": "miała",
      "explain": "Anna is a woman, so the verb takes -a: miała — the same -a as była."
    },
    {
      "prompt": "Dziecko ___ zupę.",
      "choices": [
        "miało",
        "miał",
        "miała",
        "miałam"
      ],
      "answer": "miało",
      "explain": "dziecko is neuter, and neuter past takes -o, exactly as in było."
    },
    {
      "prompt": "Siostra ___ sok.",
      "choices": [
        "piła",
        "piłam",
        "pił",
        "była"
      ],
      "answer": "piła",
      "explain": "siostra is feminine and it is she, not I — so -a with nothing after it: piła."
    },
    {
      "prompt": "Wczoraj ___ herbatę. (f)",
      "choices": [
        "chciałam",
        "chciałem",
        "chciała",
        "chciał"
      ],
      "answer": "chciałam",
      "explain": "You are the speaker and you are a woman, so the ending is -am. Without the -m it would be she wanted."
    },
    {
      "prompt": "Fix: Mama mówił cześć. →",
      "choices": [
        "mówiła",
        "mówił",
        "mówiłam",
        "była"
      ],
      "answer": "mówiła",
      "explain": "The subject is mama, so the verb has to carry her gender: mówiła."
    },
    {
      "prompt": "Syn ___ muzykę.",
      "choices": [
        "lubił",
        "lubiła",
        "lubiłem",
        "lubiłam"
      ],
      "answer": "lubił",
      "explain": "syn is a man and it is he, not I: the bare stem with -ł and no ending."
    },
    {
      "prompt": "Wczoraj ___ obiad. (m)",
      "choices": [
        "robiłem",
        "robiłam",
        "robił",
        "robiła"
      ],
      "answer": "robiłem"
    },
    {
      "prompt": "Brat ___ rower.",
      "choices": [
        "miał",
        "miała",
        "miałem",
        "miało"
      ],
      "answer": "miał"
    }
  ],
