    {
      "prompt_en": "he liked",
      "mode": "full_word",
      "answer": "lubił",
      "accepts": [
        "lubił"
      ]
    },
    {
      "prompt_en": "I drank (m)",
      "mode": "full_word",
      "answer": "piłem",
      "accepts": [
        "piłem"
      ],
      "explain": "The present has a j — piję — but the past is cut from the infinitive pić, not from the present. pi + ł + em."
    },
    {
      "prompt_en": "he had",
      "mode": "full_word",
      "answer": "miał",
      "accepts": [
        "miał"
      ],
      "explain": "miał- is the past stem of mieć. It is one of the two stems worth learning whole instead of working out."
    },
    {
      "prompt_en": "I wanted (m)",
      "mode": "full_word",
      "answer": "chciałem",
      "accepts": [
        "chciałem"
      ],
      "explain": "chciał- is the past stem of chcieć — learn it whole. The -em on the end is the ordinary man-speaking ending."
    }
  ],
