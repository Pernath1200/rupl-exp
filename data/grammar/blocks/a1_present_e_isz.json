  "intro": [
    {
      "title": "Second pattern",
      "title_pl": "Drugi wzorzec",
      "body": "Not the -am set (mieszkać). This set uses -ę/-ię, -isz, -i, -imy, -icie, -ią.\n\nTwo verbs, full six persons each: mówić (speak) and lubić (like).",
      "body_pl": "Nie wzór -am. Tu: -ę/-ię, -isz, -i, -imy, -icie, -ią.\n\nDwa czasowniki, 6 osób: mówić i lubić."
    },
    {
      "title": "mówić — full grid",
      "table": {
        "headers": [
          "Person",
          "Form",
          "English"
        ],
        "rows": [
          [
            "ja",
            "mówię",
            "I speak"
          ],
          [
            "ty",
            "mówisz",
            "you speak (sg)"
          ],
          [
            "on / ona / ono",
            "mówi",
            "he / she speaks"
          ],
          [
            "my",
            "mówimy",
            "we speak"
          ],
          [
            "wy",
