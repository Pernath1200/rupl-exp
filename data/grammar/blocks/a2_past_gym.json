  "quiz": [
    {
      "prompt": "Wczoraj ___ w domu. · I was — a man speaking",
      "choices": [
        "byłem",
        "byłam",
        "byłeś",
        "był"
      ],
      "answer": "byłem"
    },
    {
      "prompt": "Wczoraj ___ w pracy. · I was — a woman speaking",
      "choices": [
        "byłam",
        "byłem",
        "byłaś",
        "była"
      ],
      "answer": "byłam"
    },
    {
      "prompt": "Wczoraj ___ w parku? · were you — asking a woman",
      "choices": [
        "byłaś",
        "byłeś",
        "byłam",
        "była"
      ],
      "answer": "byłaś",
      "explain": "Two things have to be right at once: -a- because she is a woman, -ś because you are asking her. byłam would put you in the sentence instead of her."
    },
    {
      "prompt": "Wczoraj mama ___ obiad. · was making",
      "choices": [
        "robiła",
        "robił",
        "robiło",
        "robiłam"
      ],
      "answer": "robiła",
      "explain": "mama is feminine, so the past verb takes -a. robiłam would mean I was making it — the -m puts the speaker in the sentence."
    },
    {
      "prompt": "Wczoraj tata ___ książkę. · was reading",
      "choices": [
        "czytał",
        "czytała",
        "czytało",
        "czytałem"
      ],
      "answer": "czytał",
      "explain": "tata ends in -a but is a man, and for people the real-life gender wins — so the verb takes the bare masculine form with no ending at all."
    },
    {
      "prompt": "Wczoraj ___ kawę. · I was drinking — a woman speaking",
      "choices": [
        "piłam",
        "piłem",
        "piłaś",
        "piła"
      ],
      "answer": "piłam"
    },
    {
      "prompt": "Wczoraj ___ śniadanie. · you were making — asking a man",
      "choices": [
        "robiłeś",
        "robiłem",
        "robiłaś",
        "robił"
      ],
      "answer": "robiłeś",
      "explain": "Both robiłem and robiłeś are male forms — the gender is not the problem here, the person is. -em = I, -eś = you."
    },
    {
      "prompt": "Wczoraj Anna ___ chleb. · was buying",
      "choices": [
        "kupowała",
        "kupował",
        "kupowałam",
        "kupowało"
      ],
      "answer": "kupowała"
    },
    {
      "prompt": "Fix: Wczoraj tata piła kawę. →",
      "choices": [
        "pił",
        "piła",
        "piło",
        "piłem"
      ],
      "answer": "pił"
    },
    {
      "prompt": "Fix: Wczoraj ona chciał zupę. →",
      "choices": [
        "chciała",
        "chciał",
        "chciało",
        "chciałam"
      ],
      "answer": "chciała"
    },
    {
      "prompt": "Wczoraj nie ___ czasu. · I had — a man speaking",
      "choices": [
        "miałem",
        "miałam",
        "miał",
        "miałeś"
      ],
      "answer": "miałem",
      "explain": "miał on its own would mean he had. The -em is what puts you in the sentence, and it is the man's ending."
    },
    {
      "prompt": "Wczoraj jedzenie ___ dobre. · was",
      "choices": [
        "było",
        "był",
        "była",
        "byłem"
      ],
      "answer": "było",
      "explain": "jedzenie is neuter, and neuter takes -o — the same -o you can hear on the adjective dobre."
    }
  ],
