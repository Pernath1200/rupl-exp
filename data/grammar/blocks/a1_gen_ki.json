  "intro": [
    {
      "title": "After k and g: -i, never -y",
      "title_pl": "Po k i g: -i, nigdy -y",
      "body": "You know feminine -a → -y (kawa → kawy). One spelling fact finishes the rule: Polish never writes y after k or g. So -ka and -ga words take -i instead:\n\napteka → apteki · książka → książki · matka → matki · noga → nogi\n\nThat's the whole rule, and it never fails.",
      "body_pl": "Po k i g nigdy nie piszemy y — więc -ka/-ga → -ki/-gi: apteka → apteki, noga → nogi.",
      "table": {
        "headers": [
          "Ending",
          "Rule",
          "Examples"
        ],
        "rows": [
          [
            "-a → -y",
            "normal feminine",
            "kawa → kawy · szkoła → szkoły · woda → wody"
          ],
          [
            "-ka/-ga → -ki/-gi",
            "k/g never take y",
            "apteka → apteki · książka → książki · noga → nogi"
          ]
        ]
      }
    },
    {
      "title": "Same little words as before",
      "title_pl": "Te same słówka co zawsze",
      "body": "Every genitive word you know works the same with these forms: do apteki (to the pharmacy), z apteki, blisko apteki, dużo — and soon nie mam książki.",
      "body_pl": "do apteki · z apteki · blisko apteki · dużo · (wkrótce: nie mam książki).",
      "examples": [
        {
          "en": "I'm going to the pharmacy.",
          "pl": "Idę do apteki."
        },
        {
          "en": "I'm coming back from the pharmacy.",
          "pl": "Wracam z apteki."
        },
        {
          "en": "I live near the road.",
          "pl": "Mieszkam blisko drogi."
        },
        {
          "en": "I'm going to my mother's.",
          "pl": "Idę do matki."
        }
      ]
    }
  ],
